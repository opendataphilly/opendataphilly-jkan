---
---
[{% for dataset in site.datasets %}
  {
    "title": {{ dataset.title | jsonify }},
    "organization": {{ dataset.organization | jsonify }}{% if dataset.notes and dataset.notes != "" %},
    "notes": {{ dataset.notes | markdownify | jsonify }}{% endif %}{% if dataset.category and dataset.category != "" %},
    "category": {{ dataset.category | jsonify }}{% endif %}{% if dataset.resources.size > 0 %},
    "resource_names": {{ dataset.resources | map: "name" | join: " " | jsonify }}{% endif %}{% if dataset.tags.size > 0 %},
    "tags": {{ dataset.tags | jsonify }}{% endif %}{% if dataset.keywords.size > 0 %},
    "keywords": {{ dataset.keywords | jsonify }}{% endif %},
    "url": "{{ site.baseurl }}{{ dataset.url }}"
  }{% unless forloop.last %},{% endunless %}{% endfor %}
]
